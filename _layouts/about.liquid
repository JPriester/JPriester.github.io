---
layout: default
---
<div class="post">
  <article>
    <!-- Hero Banner -->
    <div class="hero-card">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span>⚛️ UC Santa Cruz • Hybrid Systems Lab</span>
          </div>
          <h1 class="hero-title">
            {% if site.title == 'blank' %}
              {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
          <p class="hero-subtitle">{{ page.subtitle }}</p>
          <div class="hero-lead">
            {{ page.hero_bio | markdownify }}
          </div>
          {% if page.status_banner %}
            <div class="status-pill">
              <span>🎯</span>
              <span>{{ page.status_banner }}</span>
            </div>
          {% endif %}
          <div class="hero-actions">
            <a href="#research-directions" class="btn-modern-primary">
              <span>Explore Research Directions</span>
            </a>
            <a href="{{ '/projects/' | relative_url }}" class="btn-modern-secondary">
              <span>Read Research Articles</span>
            </a>
            <a href="{{ '/publications/' | relative_url }}" class="btn-modern-secondary">
              <span>Publications</span>
            </a>
            <a href="{{ '/assets/pdf/cv.pdf' | relative_url }}" target="_blank" class="btn-modern-secondary">
              <span>CV (PDF)</span>
            </a>
          </div>
        </div>

        {% if page.profile and page.profile.image %}
          <div class="hero-profile">
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            <img
              src="{{ profile_image_path | relative_url }}"
              alt="{{ site.first_name }} {{ site.last_name }}"
              loading="eager"
            >
            {% if page.profile.more_info %}
              <div class="hero-profile-caption">{{ page.profile.more_info }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Main Content: Research Directions, Animations & Featured Articles -->
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <div class="section-header">
        <span class="section-kicker">Updates</span>
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit; text-decoration: none;">Recent News</a>
        </h2>
      </div>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div class="section-header">
        <span class="section-kicker">Bibliography</span>
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit; text-decoration: none;">Selected Publications</a>
        </h2>
        <p class="section-desc">
          View all papers organized by research area on the <a href="{{ '/publications/' | relative_url }}">full publications page →</a>
        </p>
      </div>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social" style="margin-top: 3rem;">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
