@unpublished{dePriester2026LMultiHyRL,
  abbr      = {Preprint},
  title     = {Latent Multi-Policy Hysteresis-Based Reinforcement Learning for Robust 3D Obstacle Avoidance},
  author    = {{de Priester}, Jan and Lullo, Joseph and Volle, Kyle and Ganesh, Prashant and Sanfelice, Ricardo G.},
  year      = {2026},
  note      = {Manuscript in preparation / under review (Hardware validated on ModalAI Sentinel quadrotor)},
  article   = {/projects/l_multihyrl_3d_avoidance/},
  preview   = {lmultihyrl_preview.png},
  selected  = {true},
  category  = {robust_hybrid},
  abstract  = {Deep reinforcement learning (RL) enables agile autonomous navigation from onboard sensory data, but standard continuous and memoryless RL-based policies lack robustness in topologically obstructed spaces. Specifically, when bypassing obstacles in SE(3) or tracking attitudes in SO(3), topological obstructions create decision boundaries where perturbations can induce rapid switching (chattering) between passage routes or rotation directions, trapping the vehicle at unaligned attitudes or causing collisions. To resolve these vulnerabilities, we propose Latent Multi-Policy Hysteresis-Based RL (L-MultiHyRL) for robust, perception-driven obstacle avoidance in SE(3). L-MultiHyRL identifies the critical points of a baseline RL policy, partitions the state space into overlapping contractible sets, predicts partition membership directly from learned local CNN features, and orchestrates switching via a discretized closed-loop hybrid system with dual spatial and quaternion hysteresis. Validated in 3D simulations and physical ModalAI Sentinel quadrotor flights.}
}

@inproceedings{dePriester2026RLC,
  abbr              = {RLC},
  title             = {Intrinsic Closed-Loop Practical Asymptotic Stability in Discrete-Time Reinforcement Learning},
  author            = {{de Priester}, Jan and Sanfelice, Ricardo G.},
  booktitle         = {Reinforcement Learning Conference (RLC)},
  year              = {2026},
  pdf               = {intrinsic_practical_stability_RL.pdf},
  article           = {/projects/intrinsic_stability_rl/},
  preview           = {PracticalStability_DiscountingApproximation.png},
  note              = {Accepted, to appear},
  selected          = {true},
  google_scholar_id = {RLC_SUB},
  category          = {foundations},
  abstract          = {Deep reinforcement learning (RL) has achieved impressive empirical success in complex control tasks, many of which are fundamentally set-stabilization problems. While existing methods often modify RL algorithms to enforce strict asymptotic stability, we offer a complementary perspective: modifying the core RL objective is often unnecessary to guarantee the stability of the deployed policy. We prove that the unmodified discounted RL objective intrinsically guarantees closed-loop uniform practical asymptotic stability (UPAS) in deterministic continuous control settings. By adapting the discrete-time input-to-state stability (ISS) framework, we model the suboptimality induced by the discount factor and neural network approximation error as bounded disturbances, proving that near-optimal parameterized feedback laws steer the closed-loop system into a bounded neighborhood of the target set that vanishes as approximation error approaches zero and the discount factor approaches one.}
}

@inproceedings{spott2026experimental,
  abbr              = {CCTA},
  title             = {An Experimentally Validated Hybrid Control Strategy for Robust Contact Detection and Force Regulation},
  author            = {Spott, India and {de Priester}, Jan and Sanfelice, Ricardo G.},
  booktitle         = {IEEE Conference on Control Technology and Applications (CCTA)},
  year              = {2026},
  note              = {Accepted, to appear},
  preview           = {gripper_CCTA26.jpg},
  google_scholar_id = {CCTA_SUB},
  category          = {robotics},
  abstract          = {Robotic manipulators transitioning between free-space motion and contact-rich force regulation are susceptible to contact chattering caused by sensor noise and surface compliance near the contact threshold. We present an experimentally validated hybrid control strategy utilizing hysteresis-based mode switching to guarantee robust contact detection and smooth force regulation on a physical 6-DoF robotic manipulator.}
}

@inproceedings{dePriester2025TimerHyRL,
  abbr              = {RLC},
  title             = {A Timer-Based Hybrid Supervisor for Robust, Chatter-Free Policy Switching},
  author            = {{de Priester}, Jan and Sanfelice, Ricardo G.},
  booktitle         = {Reinforcement Learning Conference (RLC)},
  volume            = {6},
  pages             = {2508--2529},
  year              = {2025},
  preview           = {timerhyrl_timerapproach5.jpg},
  pdf               = {timerHyrlpaper.pdf},
  article           = {/projects/timer_based_hybrid_supervisor/},
  dimensions        = {true},
  selected          = {true},
  google_scholar_id = {qjMakFHDy7sC},
  category          = {robust_hybrid},
  abstract          = {We address the challenge of switching among multiple learned policies in reinforcement learning control systems, where conventional value function-based selection can induce rapid chattering under small measurement noise. We propose a predictive timer-based hybrid supervisor that integrates a resettable timer enforcing an adaptive dwell time on the active policy by predicting forward trajectories, rendering the target set robustly globally asymptotically stable.}
}

@inproceedings{dePriester2024MultiHyRL,
  abbr              = {RLC},
  title             = {{MultiHyRL}: {R}obust Hybrid {RL} for Obstacle Avoidance against Adversarial Attacks on the Observation Space},
  author            = {{de Priester}, Jan and Bell, Zachary and Ganesh, Prashant and Sanfelice, Ricardo G.},
  booktitle         = {Reinforcement Learning Conference (RLC)},
  volume            = {4},
  pages             = {2017--2040},
  year              = {2024},
  preview           = {multihyrlpreview.jpg},
  pdf               = {MultihyrlPaper.pdf},
  article           = {/projects/2Dmultihyrl/},
  dimensions        = {true},
  selected          = {true},
  google_scholar_id = {2osOgNQ5qMEC},
  category          = {robust_hybrid},
  abstract          = {Standard continuous reinforcement learning policies lack formal robustness guarantees against adversarial perturbations in the observation space during obstacle avoidance, where topological obstructions create vulnerable decision boundaries. MultiHyRL identifies critical points of a baseline policy and constructs overlapping relaxed Voronoi partitions with hysteresis switching, guaranteeing robust navigation across multi-obstacle environments.}
}

